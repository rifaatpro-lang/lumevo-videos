<div class="lv lv-bar" role="region" aria-label="Contact rapide">
  <a class="lv-btn lv-btn--call" href="{{ section.settings.tel_url }}" aria-label="Appeler Lumevo Électricien au {{ section.settings.tel_text }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
    <span class="lv-bar__short">{{ section.settings.tel_label }}</span><span class="lv-bar__long">{{ section.settings.tel_text }}</span>
  </a>
  <a class="lv-btn lv-btn--white" href="{{ section.settings.devis_url | default: '/pages/contact-devis' }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
    <span>{{ section.settings.devis_label }}</span>
  </a>
</div>
<script>
(function(){var e=document.querySelectorAll('.lv-reveal');if(!('IntersectionObserver' in window)){e.forEach(function(n){n.classList.add('is-in')});return}
var o=new IntersectionObserver(function(a){a.forEach(function(i){if(i.isIntersecting){i.target.classList.add('is-in');o.unobserve(i.target)}})},{rootMargin:'0px 0px -8% 0px',threshold:.08});
e.forEach(function(n){o.observe(n)});setTimeout(function(){e.forEach(function(n){n.classList.add('is-in')})},2500);})();
</script>
<script>
(function(){var b=document.querySelector('.lv-bar');if(!b)return;
var t=b.querySelector('a[href^="tel:"]'),u=document.querySelector('#navbar-mobile .col-3:last-child .nav');
if(t&&u&&!u.querySelector('.lv-hcall')){var a=document.createElement('a');a.className='lv-hcall';a.href=t.getAttribute('href');a.setAttribute('aria-label',t.getAttribute('aria-label')||'Appeler');a.innerHTML=t.querySelector('svg').outerHTML;var l=document.createElement('li');l.className='nav-item lv-hli';l.appendChild(a);u.appendChild(l)}
document.querySelectorAll('ul,ol').forEach(function(l){for(var i=0;i<l.children.length;i++){var n=l.children[i].tagName;if(n!=='LI'&&n!=='SCRIPT'&&n!=='TEMPLATE'){l.setAttribute('role','presentation');break}}});
var h=document.querySelector('.lv-hero .lv-actions,.lv-phero .lv-actions');
if(h&&'IntersectionObserver' in window){b.style.transition='none';b.classList.add('is-off');setTimeout(function(){b.style.transition=''},400);new IntersectionObserver(function(x){b.classList.toggle('is-off',x[0].isIntersecting)},{threshold:.6}).observe(h)}
})();
</script>
{% schema %}
{"name":"Lumevo – barre d'action","settings":[
{"type":"text","id":"tel_label","label":"Bouton appel (téléphone)","default":"Appeler"},
{"type":"text","id":"tel_text","label":"Numéro affiché","default":"07 50 01 90 25"},
{"type":"text","id":"tel_url","label":"Lien d'appel","default":"tel:0750019025"},
{"type":"text","id":"devis_label","label":"Bouton devis","default":"Devis gratuit"},
{"type":"url","id":"devis_url","label":"Lien devis"}]}
{% endschema %}
