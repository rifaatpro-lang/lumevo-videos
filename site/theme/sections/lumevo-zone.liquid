<section class="lv lv-sec">
  <div class="lv-wrap lv-zone__grid">
    <div class="lv-reveal">
      <p class="lv-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="lv-h2">{{ section.settings.title }}</h2>
      <p class="lv-sub">{{ section.settings.text }}</p>
      <ul class="lv-cities">
        {% for block in section.blocks %}
          {% liquid
            assign city_handle = block.settings.name | handleize | prepend: 'electricien-' | append: '-95'
            assign city_page = pages[city_handle]
          %}
          <li {{ block.shopify_attributes }}>
            {% if block.settings.url != blank %}<a class="lv-city" href="{{ block.settings.url }}">{{ block.settings.name }}</a>
            {% elsif city_page.title != blank %}<a class="lv-city" href="{{ city_page.url }}">{{ block.settings.name }}</a>
            {% else %}<span class="lv-city">{{ block.settings.name }}</span>{% endif %}
          </li>
        {% endfor %}
      </ul>
      {% if section.settings.btn_label != blank %}<div class="lv-actions"><a class="lv-btn lv-btn--dark" href="{{ section.settings.btn_url }}">{{ section.settings.btn_label }}</a></div>{% endif %}
    </div>
    {% if section.settings.map_src != blank %}
      <div class="lv-map lv-reveal"><iframe src="{{ section.settings.map_src }}" title="{{ section.settings.map_title | escape }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
    {% endif %}
  </div>
</section>
{% schema %}
{"name":"Lumevo – zone d'intervention","settings":[
{"type":"text","id":"eyebrow","label":"Sur-titre","default":"Zone d'intervention"},{"type":"text","id":"title","label":"Titre (H2)"},{"type":"textarea","id":"text","label":"Texte"},
{"type":"text","id":"btn_label","label":"Bouton"},{"type":"url","id":"btn_url","label":"Lien du bouton"},
{"type":"text","id":"map_src","label":"Adresse de la carte Google (embed)"},{"type":"text","id":"map_title","label":"Titre de la carte","default":"Lumevo Électricien sur Google Maps"}],
"blocks":[{"type":"ville","name":"Ville","settings":[{"type":"text","id":"name","label":"Nom de la ville","info":"Le lien se crée tout seul si la page electricien-ville-95 est en ligne."},{"type":"url","id":"url","label":"Lien forcé (facultatif)"}]}],
"presets":[{"name":"Lumevo – zone d'intervention"}]}
{% endschema %}
